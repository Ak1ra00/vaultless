# PlatformIO / ESP-IDF build output
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
firmware/build/
# Per-env sdkconfig is generated by the IDF build; the *.defaults files that
# feed it are real sources and must stay tracked.
firmware/sdkconfig
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
!firmware/sdkconfig.secure.defaults

# PlatformIO synthesises these for the arduino-as-espidf-component build
firmware/CMakeLists.txt
firmware/src/CMakeLists.txt
firmware/managed_components/
firmware/dependencies.lock

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Local env — never commit
.env
.env.*
!.env.example
